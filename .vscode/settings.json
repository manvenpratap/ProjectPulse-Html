{
  "javascript.validate.enable": false,
  "typescript.validate.enable": false,
  "html.validate.scripts": false,
  "files.associations": {
    "*.html": "html"
  },
  "python.analysis.ignore": [
    "**"
  ],
  "python.analysis.diagnosticMode": "off",
  "python.analysis.typeCheckingMode": "off",
  "python.diagnostics.ignoredFiles": [
    "**"
  ],
  "python.linting.enabled": false,
  "python.linting.lintOnSave": false,
  "pyrefly.enable": false,
  "pyrefly.displayDiagnostics": false,
  "pyrefly.checkOnSave": false,
  "pyrefly.checkOnType": false,
  "pyrefly.ignore": [
    "**"
  ],
  "pyright.analysis.diagnosticMode": "off"
}
